<Project Sdk="Microsoft.NET.Sdk">

	<!-- The demo app itself: layout, image list and (later) the pipeline run and 3D preview. Both heads
	     consume this one assembly, so nothing here may reference a platform project - that would pull a
	     desktop window host into the wasm publish, or the browser host into the mac build (the same rule
	     as agg-sharp's examples/AggSharpDemo/AggSharpDemo, which this copies). -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>ColmapDemo</RootNamespace>
		<!-- The pure parts (decode, mesh bridge, session) are tested in ColmapDemo.Tests. -->
		<Company>Lars Brubaker</Company>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ColmapSharp\ColmapSharp.csproj" />
		<ProjectReference Include="..\agg-sharp\agg\Agg.csproj" />
		<ProjectReference Include="..\agg-sharp\Gui\Gui.csproj" />
		<ProjectReference Include="..\agg-sharp\VectorMath\VectorMath.csproj" />
		<ProjectReference Include="..\agg-sharp\DataConverters2D\DataConverters2D.csproj" />
		<ProjectReference Include="..\agg-sharp\PolygonMesh\PolygonMesh.csproj" />
		<ProjectReference Include="..\agg-sharp\RenderCore\RenderCore.csproj" />
		<ProjectReference Include="..\agg-sharp\RenderGl\RenderGl.csproj" />
		<ProjectReference Include="..\agg-sharp\WebGpuRender\WebGpuRender.csproj" />
		<ProjectReference Include="..\agg-sharp\WebGpu\MatterHackers.WebGpu.csproj" />
	</ItemGroup>

</Project>
