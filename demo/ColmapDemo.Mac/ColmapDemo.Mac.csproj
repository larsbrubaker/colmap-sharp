<Project Sdk="Microsoft.NET.Sdk">

	<!-- The mac head: a window around ColmapDemoApp, nothing else. agg-sharp's AppKit host is plain
	     net10.0 (no macOS workload), so this builds on any OS but only runs on a Mac. The library itself
	     stays pure managed; only this head reaches native code, through agg-sharp's platform project. -->

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<RootNamespace>ColmapDemo</RootNamespace>
		<Company>Lars Brubaker</Company>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\ColmapDemo\ColmapDemo.csproj" />
		<ProjectReference Include="..\agg-sharp\PlatformMac\PlatformMac.csproj" />
	</ItemGroup>

</Project>
